<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Rony.Net.NUnit</PackageId>
    <Description>NUnit integration for Rony.Net: a MockServerTest base class that starts a mock server for every test and writes its log to the test output, and a LogToTestContext() extension.</Description>
    <PackageProjectUrl>https://github.com/archofthings/Rony.Net/wiki/Test-Framework-Integration</PackageProjectUrl>
    <PackageTags>mock;mock-server;tcp;udp;socket;testing;nunit;rony</PackageTags>
    <PackageReleaseNotes>Released together with Rony.Net 1.2.0; no changes of its own. See https://github.com/archofthings/Rony.Net/blob/main/CHANGELOG.md</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NUnit" Version="3.14.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Rony\Rony.csproj" />
  </ItemGroup>

</Project>
