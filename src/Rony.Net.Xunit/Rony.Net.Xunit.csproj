<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Rony.Net.Xunit</PackageId>
    <Description>xUnit (v2) integration for Rony.Net: a MockServerTest base class that starts a mock server for every test and writes its log to the test output, and a LogTo(ITestOutputHelper) extension.</Description>
    <PackageProjectUrl>https://github.com/archofthings/Rony.Net/wiki/Test-Framework-Integration</PackageProjectUrl>
    <PackageTags>mock;mock-server;tcp;udp;socket;testing;xunit;rony</PackageTags>
    <PackageReleaseNotes>Released together with Rony.Net 1.5.0; no changes of its own. See https://github.com/archofthings/Rony.Net/blob/main/CHANGELOG.md</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.abstractions" Version="2.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Rony\Rony.csproj" />
  </ItemGroup>

</Project>
