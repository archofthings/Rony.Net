<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Rony.Net.MSTest</PackageId>
    <Description>MSTest (v4) integration for Rony.Net: a MockServerTest base class that starts a mock server for every test and writes its log to the test output, and a LogTo(TestContext) extension.</Description>
    <PackageProjectUrl>https://github.com/archofthings/Rony.Net/wiki/Test-Framework-Integration</PackageProjectUrl>
    <PackageTags>mock;mock-server;tcp;udp;socket;testing;mstest;rony</PackageTags>
    <PackageReleaseNotes>Released together with Rony.Net 1.5.0; no changes of its own. See https://github.com/archofthings/Rony.Net/blob/main/CHANGELOG.md</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- MSTest 4 moved TestContext to another assembly, so a build for MSTest 3 does not load on MSTest 4 (and the other way round) -->
    <PackageReference Include="MSTest.TestFramework" Version="4.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Rony\Rony.csproj" />
  </ItemGroup>

</Project>
