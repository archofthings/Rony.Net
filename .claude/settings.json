{
  "model": "claude-opus-5-5",
  "env": {
    "DOTNET_ROLL_FORWARD": "Major",
    "DOTNET_CLI_TELEMETRY_OPTOUT": "1",
    "DOTNET_NOLOGO": "1"
  },
  "permissions": {
    "allow": [
      "Bash(dotnet build*)",
      "Bash(dotnet test*)",
      "Bash(dotnet restore*)",
      "Bash(dotnet pack*)",
      "Bash(dotnet format*)",
      "Bash(dotnet --version*)",
      "Bash(dotnet --list-sdks*)",
      "Bash(dotnet --list-runtimes*)",
      "Bash(.claude/skills/setup-dev/scripts/setup_dev.sh*)",
      "Bash(.claude/skills/release/scripts/check_release.sh*)",
      "Bash(git diff*)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(gh pr view*)",
      "Bash(gh pr list*)",
      "Bash(gh pr diff*)",
      "Bash(gh pr checks*)",
      "Bash(gh run list*)",
      "Bash(gh run view*)",
      "Bash(gh release list*)",
      "Bash(gh release view*)",
      "Bash(gh repo view*)",
      "Bash(gh auth status*)",
      "Bash(git show*)",
      "Bash(git fetch*)"
    ],
    "ask": [
      "Bash(gh pr create*)",
      "Bash(gh pr edit*)",
      "Bash(gh pr merge*)",
      "Bash(gh pr close*)",
      "Bash(gh pr comment*)",
      "Bash(gh pr review*)",
      "Bash(gh release create*)",
      "Bash(gh release edit*)",
      "Bash(gh release upload*)",
      "Bash(gh issue create*)",
      "Bash(gh issue comment*)",
      "Bash(gh api*)",
      "Bash(gh workflow run*)"
    ],
    "deny": [
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(git tag*)",
      "Bash(dotnet nuget push*)",
      "Bash(dotnet nuget delete*)",
      "Bash(gh repo delete*)",
      "Bash(gh release delete*)",
      "Bash(gh auth logout*)",
      "Bash(gh auth token*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block_disk_scan.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/build_changed.py",
            "timeout": 120
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check_versions.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
